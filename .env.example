# Copia este archivo a .env.local y rellena los valores. Los de aquí son ficticios.
# Las variables con prefijo NEXT_PUBLIC_ llegan al navegador; las demás solo al servidor.

# --- Supabase (obligatorias) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo
# Nunca con prefijo NEXT_PUBLIC_: salta RLS por completo.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo-service-role

# --- Sitio (obligatorias) --------------------------------------------------------
# URL pública sin barra final. Se usa para armar los enlaces de correo (recuperar
# contraseña, alta de administradores): si queda en localhost, los enlaces no sirven.
NEXT_PUBLIC_SITE_URL=https://www.ejemplo.com

# Número de WhatsApp del club: solo dígitos, indicativo 57 más las 10 cifras
# del celular (12 en total). Sin esto los botones de WhatsApp quedan deshabilitados.
NEXT_PUBLIC_WHATSAPP_NUMERO=573001234567

# Cuentas de usuario (deportistas y acudientes, /cuenta/*). Apagadas en la
# primera entrega: cualquier valor distinto de "true" responde 404.
CUENTAS_HABILITADAS=false

# --- Fase 4: Wompi (todavía sin uso en el código) --------------------------------
WOMPI_PUBLIC_KEY=pub_test_ejemplo
WOMPI_PRIVATE_KEY=prv_test_ejemplo
WOMPI_INTEGRITY_SECRET=test_integrity_ejemplo
WOMPI_EVENTS_SECRET=test_events_ejemplo
WOMPI_ENV=test
CRON_SECRET=cadena-aleatoria-larga
